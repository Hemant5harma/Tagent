[Unit]
Description=Trade Agent authenticated MT5 connector
Requires=trade-agent-terminal.service
After=trade-agent-terminal.service
PartOf=trade-agent-terminal.service

[Service]
WorkingDirectory=%h/trade-agent
EnvironmentFile=%h/trade-agent/connector.env
Environment=DISPLAY=:99
Environment=WINEPREFIX=%h/trade-agent/wineprefix
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/wine %h/trade-agent/wineprefix/drive_c/Python313/python.exe -m mt5_connector.main
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
