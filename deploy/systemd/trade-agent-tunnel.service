[Unit]
Description=Temporary Cloudflare dashboard tunnel
After=trade-agent-dashboard.service
Requires=trade-agent-dashboard.service

[Service]
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/trade-agent
EnvironmentFile=/home/jarvis/trade-agent/.env
ExecStart=/home/jarvis/trade-agent/.venv/bin/python -m trade_agent.tunnel
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
