[Unit]
Description=Trade Agent backend
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=tradeagent
Group=tradeagent
WorkingDirectory=/opt/trade-agent
EnvironmentFile=/etc/trade-agent/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trade-agent/.venv/bin/trade-agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-agent
UMask=0077

[Install]
WantedBy=multi-user.target
