[Unit]
Description=Trade Agent public read-only dashboard
After=network-online.target docker.service

[Service]
User=trade-dashboard
Group=trade-dashboard
WorkingDirectory=/opt/trade-agent-dashboard
EnvironmentFile=/opt/trade-agent-dashboard/dashboard.env
ExecStart=/opt/trade-agent-dashboard/runtime/bin/python -m trade_agent.dashboard
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
