[Unit]
Description=Trade Agent multi-agent research and authorized demo entries
After=network-online.target docker.service

[Service]
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/trade-agent
EnvironmentFile=/home/jarvis/trade-agent/.env
ExecStart=/home/jarvis/trade-agent/.venv/bin/python -m trade_agent.autonomy
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
