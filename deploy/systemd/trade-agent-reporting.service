[Unit]
Description=Trade Agent broker reporting collector
After=network-online.target docker.service

[Service]
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/trade-agent
EnvironmentFile=/home/jarvis/trade-agent/.env
ExecStart=/home/jarvis/trade-agent/.venv/bin/python -m trade_agent.reporting
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
