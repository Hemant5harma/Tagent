# Use SQLite only for local development/tests. Use postgresql+psycopg://... in production.
TRADE_AGENT_DATABASE_URL=sqlite:///./data/trade_agent.db
# Local-only convenience. Production must run `alembic upgrade head` and omit this.
TRADE_AGENT_AUTO_CREATE_SCHEMA=true
TRADE_AGENT_TELEGRAM_BOT_TOKEN=
TRADE_AGENT_TELEGRAM_OWNER_ID=0
# Required for every /v1 operation; health endpoints remain unauthenticated.
TRADE_AGENT_HTTP_API_TOKEN=change-me
TRADE_AGENT_ACCOUNT_ID=demo-mt5
TRADE_AGENT_BROKER_MODE=fake
TRADE_AGENT_MT5_CONNECTOR_URL=http://127.0.0.1:8101
TRADE_AGENT_MT5_CONNECTOR_TOKEN=change-me
TRADE_AGENT_TRADING_MODE=demo
TRADE_AGENT_TIMEZONE=Asia/Kolkata
TRADE_AGENT_MAX_VOLUME=1.00
TRADE_AGENT_MAX_OPEN_POSITIONS=5
TRADE_AGENT_MAX_PENDING_ORDERS=5
TRADE_AGENT_MAX_PENDING_SUBMISSIONS=1
TRADE_AGENT_MAX_TOTAL_VOLUME=5.00
TRADE_AGENT_MAX_ESTIMATED_LOSS=500.00
TRADE_AGENT_MIN_FREE_MARGIN_AFTER_TRADE=500.00
TRADE_AGENT_MAX_SPREAD_POINTS=50
TRADE_AGENT_MAX_SLIPPAGE_POINTS=20
TRADE_AGENT_CONFIRMATION_TTL_SECONDS=300
TRADE_AGENT_MONITOR_INTERVAL_SECONDS=5
TRADE_AGENT_DEADLINE_INTERVAL_SECONDS=1
TRADE_AGENT_ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY

# AI profiles are selected explicitly; provider failures never affect execution.
TRADE_AGENT_AI_PROVIDER=none
TRADE_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
TRADE_AGENT_OPENAI_API_KEY=
TRADE_AGENT_OPENAI_MODEL=
TRADE_AGENT_OPENAI_PROTOCOL=chat_completions
TRADE_AGENT_OPENAI_RESPONSE_FORMAT=json_schema
TRADE_AGENT_OPENAI_TIMEOUT_SECONDS=30
# TRADE_AGENT_OPENAI_REASONING_EFFORT=low
# TRADE_AGENT_OPENAI_MAX_COMPLETION_TOKENS=3000
TRADE_AGENT_OPENCODE_URL=http://127.0.0.1:4096
TRADE_AGENT_OPENCODE_MODEL_PROVIDER=
TRADE_AGENT_OPENCODE_MODEL=
TRADE_AGENT_CODEX_COMMAND=codex
TRADE_AGENT_CODEX_MODEL=

# Opt-in multi-agent research using the AI profile above. No Ollama required.
# off -> shadow (no orders) -> demo (requires expiring owner authorization).
TRADE_AGENT_AUTONOMY_MODE=off
TRADE_AGENT_AUTONOMY_TIMEFRAME=M15
TRADE_AGENT_AUTONOMY_BARS=200
TRADE_AGENT_AUTONOMY_INTERVAL_SECONDS=60
TRADE_AGENT_AUTONOMY_MIN_CONFIDENCE=0.70
TRADE_AGENT_AUTONOMY_RISK_AMOUNT=5
TRADE_AGENT_AUTONOMY_MAX_VOLUME=0.10
TRADE_AGENT_AUTONOMY_STOP_ATR=2
TRADE_AGENT_AUTONOMY_REWARD_RISK=2
TRADE_AGENT_AUTONOMY_MAX_HOLDING_MINUTES=240
TRADE_AGENT_AUTONOMY_CONTEXT_ENABLED=false
TRADE_AGENT_AUTONOMY_TRADE_PLANS_ENABLED=false
TRADE_AGENT_AUTONOMY_COMPARISON_ENABLED=false
TRADE_AGENT_FRED_API_KEY=

# Connector-only variables. On production hosts keep these in a separate,
# protected connector environment file rather than the backend environment.
MT5_CONNECTOR_TOKEN=change-me
MT5_CONNECTOR_DEVIATION_POINTS=20
MT5_CONNECTOR_JOURNAL_PATH=./data/mt5_connector_requests.jsonl
